{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "DEPLOY.md",
      "FIRESTORE-RULES.md"
    ],
    "headers": [
      {
        "source": "assets/**/*.@(js|css|png|jpg|jpeg|svg|webp)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
